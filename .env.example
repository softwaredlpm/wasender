# ==============================================================================
# WASENDER SAAS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in your local environment. NEVER commit real secrets to git.
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# SERVICE ROLE KEY IS FOR BACKEND VPS API ONLY - NEVER EXPOSE TO FRONTEND
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- VPS BACKEND API & WEBSOCKET ---
PORT=5000
VPS_API_URL=https://api.wasender.com
WSS_SERVER_URL=wss://api.wasender.com/agent
JWT_SECRET=generate-a-strong-random-secret-at-least-32-chars
CORS_ORIGIN=https://app.wasender.com,http://localhost:3000

# --- RAZORPAY BILLING INTEGRATION ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- OPTIONAL CLOUDFLARE R2 ASSET STORAGE (Permanent Campaign Media Only) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=wasender-campaign-assets
R2_PUBLIC_DOMAIN=https://assets.wasender.com

# --- LOCAL AGENT SETTINGS (Windows PC) ---
AGENT_LOCAL_PORT=5000
AGENT_DATA_DIR=%APPDATA%/WASENDER
NODE_ENV=production
